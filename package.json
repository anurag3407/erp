{
  "name": "enterprise-college-erp",
  "version": "2.0.0",
  "description": "Enterprise-Grade College ERP using Next.js 15, PostgreSQL & Redis with built-in fixes for concurrency, proxy attendance, degree audit, exam seating, and fee reconciliation.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "test": "node --loader ts-node/esm tests/run-gap-fixes-verification.ts",
    "test:gap-fixes": "node --loader ts-node/esm tests/run-gap-fixes-verification.ts",
    "test:e2e": "node --loader ts-node/esm tests/e2e/e2e-workflow.test.ts",
    "test:scanner": "node --loader ts-node/esm tests/gap-scanner.ts",
    "typecheck": "tsc --noEmit",
    "build:cf": "opennextjs-cloudflare build",
    "preview:cf": "npm run build:cf && wrangler dev",
    "deploy:cf": "npm run build:cf && wrangler deploy"
  },
  "dependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "crypto": "^1.0.1",
    "drizzle-orm": "^0.38.4",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  }
}
