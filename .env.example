# PostgreSQL connection string (required). Example for local Postgres:
DATABASE_URL=postgresql://<user>@localhost:5432/enterprise_college_erp

# Upstash Redis REST API credentials (required for serverless/edge Redis)
# Obtain from https://console.upstash.com/redis -> Details -> REST API
UPSTASH_REDIS_REST_URL=https://<your-database>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-upstash-rest-token>

# Cryptographic secrets — REQUIRED in production (>= 16 chars). The app fails
# closed if these are unset when NODE_ENV=production.
# ERP_CRYPTO_SECRET=
# WAITING_ROOM_SECRET=
# OSV_SECRET=

# WebAuthn deployment origin validated against clientDataJSON (`origin` claim).
# WEBAUTHN_ORIGIN=https://erp.example.edu
# Only set this to bypass signature verification for non-PEM demo authenticators.
# WEBAUTHN_ALLOW_UNVERIFIED_SIGNATURES=false

# LTI 1.3 platform public key (PEM). When set, launch JWT signatures are
# verified against it; otherwise the institutional Ed25519 key is used.
# LTI_PLATFORM_PUBLIC_KEY=

# Password given to seeded demo accounts (email + password login). Change it
# before exposing this instance to anyone.
SEED_DEFAULT_PASSWORD=ChangeMe!2026Secure

# Auth sessions are stored in Redis under the keyspace 'erp:session:*' with a
# 7-day sliding TTL. Session tokens are 256-bit random values; no JWT secret is
# required for cookie sessions.

# Login throttling & lockout (counted in Redis per email and per client IP).
LOGIN_MAX_ATTEMPTS=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900

# Password reset: tokens live 30 minutes and are single-use.

# Transactional email delivery (Plunk). Without these, reset links cannot be
# delivered and the request action falls back to returning the token outside
# production. Create a secret key (sk_*) at https://dashboard.useplunk.com.
# PLUNK_API_KEY=sk_live_...
# MAIL_FROM="Nexus ERP <no-reply@your-domain.edu>"   # domain must be verified in Plunk
# APP_BASE_URL=https://erp.your-college.edu          # used to build reset links
